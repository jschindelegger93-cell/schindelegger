---
import Icon from './Icon.astro';
import s from '../data/settings.json';
const steps = ['Ausgangslage', 'Themen', 'Budget & Zeitpunkt', 'Website', 'Kontakt'];
---
<div class="modal" id="beratung" role="dialog" aria-modal="true" aria-labelledby="modal-title" hidden>
  <div class="modal-bg" data-close></div>
  <div class="modal-box">
    <div class="modal-head">
      <span class="icon-bubble"><Icon name="chart" /></span>
      <div>
        <h2 id="modal-title">Kostenlose Potenzialanalyse</h2>
        <p>Unverbindlich · Antwort {s.antwortzeit}</p>
      </div>
      <button class="modal-x" type="button" data-close aria-label="Schließen">×</button>
    </div>
    <div class="progress" data-progress>
      <div class="progress-meta"><span data-step-name>{steps[0]}</span><span>Schritt <span data-step-num>1</span> von 5</span></div>
      <div class="progress-bar"><span></span></div>
    </div>
    <form class="modal-body" name="beratung" method="POST" action="/danke/" data-netlify="true" netlify-honeypot="bot-field" data-modal-form>
      <input type="hidden" name="form-name" value="beratung" />
      <input type="hidden" name="quelle" value="" data-source />
      <p class="hp"><label>Nicht ausfüllen <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

      <fieldset class="modal-step" data-step="1" data-name={steps[0]} style="border:0;padding:0;margin:0">
        <legend><h3>Was beschreibt Ihr Unternehmen am besten?</h3></legend>
        <p class="muted">Damit die Einschätzung zu Ihrer Situation passt.</p>
        <div class="tiles">
          <label class="tile"><input type="radio" name="typ" value="Online-Shop" data-auto /><span><b>Online-Shop</b><small>eCommerce, D2C, Shopify</small></span></label>
          <label class="tile"><input type="radio" name="typ" value="Leadgenerierung" data-auto /><span><b>Dienstleister & B2B</b><small>Anfragen, Termine, Angebote</small></span></label>
          <label class="tile"><input type="radio" name="typ" value="Hotellerie" data-auto /><span><b>Hotel & Tourismus</b><small>Direktbuchungen</small></span></label>
          <label class="tile"><input type="radio" name="typ" value="Andere" data-auto /><span><b>Etwas anderes</b><small>Verein, Politik, Start-up …</small></span></label>
        </div>
      </fieldset>

      <fieldset class="modal-step" data-step="2" data-name={steps[1]} hidden style="border:0;padding:0;margin:0">
        <legend><h3>Worum geht es?</h3></legend>
        <p class="muted">Mehrfachauswahl möglich.</p>
        <div class="pills" style="margin-top:14px">
          {['Growth System (alles aus einer Hand)', 'Google & Meta Ads', 'ChatGPT Ads', 'SEO & GEO', 'Shopify & eCommerce', 'Tracking & Analytics', 'E-Mail & Klaviyo', 'Creatives & UGC', 'Landingpage', 'Noch unklar'].map((t) => (
            <label class="pill"><input type="checkbox" name="themen" value={t} data-theme /><span>{t}</span></label>
          ))}
        </div>
      </fieldset>

      <fieldset class="modal-step" data-step="3" data-name={steps[2]} hidden style="border:0;padding:0;margin:0">
        <legend><h3>Wie hoch ist Ihr monatliches Werbebudget?</h3></legend>
        <p class="muted">SEO, Ads und Social Media zusammen. Ein Richtwert genügt.</p>
        <div class="tiles">
          <label class="tile"><input type="radio" name="budget" value="unter 2.000 €" /><span><b>unter 2.000 €</b><small>Start</small></span></label>
          <label class="tile"><input type="radio" name="budget" value="2.000–5.000 €" /><span><b>2.000–5.000 €</b><small>Wachstum</small></span></label>
          <label class="tile"><input type="radio" name="budget" value="5.000–25.000 €" /><span><b>5.000–25.000 €</b><small>Skalierung</small></span></label>
          <label class="tile"><input type="radio" name="budget" value="über 25.000 €" /><span><b>über 25.000 €</b><small>Volle Skalierung</small></span></label>
        </div>
        <div class="field" style="margin-top:18px">
          <label for="m-zeit">Wann soll es losgehen?</label>
          <select id="m-zeit" name="zeitpunkt"><option>So bald wie möglich</option><option>In 1–3 Monaten</option><option>Erst einmal informieren</option></select>
        </div>
      </fieldset>

      <fieldset class="modal-step" data-step="4" data-name={steps[3]} hidden style="border:0;padding:0;margin:0">
        <legend><h3>Wo sind Sie online zu finden?</h3></legend>
        <p class="muted">Optional, aber damit kann ich vorab einen Blick auf Website und Konten werfen.</p>
        <div class="field"><label for="m-web">Website <small>(optional)</small></label><input id="m-web" name="website" type="url" inputmode="url" placeholder="https://ihre-website.at" /></div>
        <div class="field" style="margin-top:14px"><label for="m-msg">Was ist die größte Baustelle? <small>(optional)</small></label><textarea id="m-msg" name="nachricht" rows="3" placeholder="z. B. steigende Klickpreise, kaum Anfragen über die Website …"></textarea></div>
      </fieldset>

      <fieldset class="modal-step" data-step="5" data-name={steps[4]} hidden style="border:0;padding:0;margin:0">
        <legend><h3>Wie erreiche ich Sie?</h3></legend>
        <div class="form">
          <div class="row">
            <div class="field"><label for="m-name">Name</label><input id="m-name" name="name" required autocomplete="name" /></div>
            <div class="field"><label for="m-firma">Unternehmen <small>(optional)</small></label><input id="m-firma" name="unternehmen" autocomplete="organization" /></div>
          </div>
          <div class="row">
            <div class="field"><label for="m-mail">E-Mail</label><input id="m-mail" name="email" type="email" required autocomplete="email" inputmode="email" /></div>
            <div class="field"><label for="m-tel">Telefon <small>(optional)</small></label><input id="m-tel" name="telefon" type="tel" autocomplete="tel" inputmode="tel" /></div>
          </div>
          <div class="field"><span style="display:block;font-weight:600;font-size:.92rem;margin-bottom:6px">Bevorzugter Kontaktweg</span>
            <div class="pills">
              <label class="pill"><input type="radio" name="kontaktweg" value="E-Mail" checked /><span>E-Mail</span></label>
              <label class="pill"><input type="radio" name="kontaktweg" value="Rückruf" /><span>Rückruf</span></label>
              <label class="pill"><input type="radio" name="kontaktweg" value="WhatsApp" /><span>WhatsApp</span></label>
            </div>
          </div>
          <label class="consent"><input type="checkbox" name="datenschutz" required /> Ich stimme der Verarbeitung meiner Angaben gemäß <a href="/datenschutz/">Datenschutzerklärung</a> zu. Keine Weitergabe an Dritte.</label>
        </div>
        <p class="muted" data-error role="alert" aria-live="polite" style="color:#c0391b"></p>
      </fieldset>

      <div class="modal-step thanks" data-step="done" hidden>
        <img class="avatar" src={s.inhaberBild} alt={s.inhaberKurz} width="84" height="84" loading="lazy" />
        <h3>Danke, die Anfrage ist da.</h3>
        <p>{s.inhaberKurz} meldet sich persönlich {s.antwortzeit} mit einer ehrlichen Einschätzung, auch wenn kein Hebel erkennbar ist.</p>
        <p class="muted">Dringend? <a href={`tel:${s.telefon.replace(/\s/g, '')}`}>{s.telefon}</a></p>
      </div>
    </form>
    <div class="modal-foot" data-foot>
      <span class="secure"><Icon name="lock" /><span>SSL-verschlüsselt · DSGVO-konform</span></span>
      <button class="btn btn-outline" type="button" data-back hidden>Zurück</button>
      <button class="btn btn-primary" type="button" data-next disabled><span data-next-label>Weiter</span> <Icon name="arrow" /></button>
    </div>
  </div>
</div>

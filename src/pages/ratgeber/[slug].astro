---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection, render } from 'astro:content';
import s from '../../data/settings.json';
export async function getStaticPaths() {
  return (await getCollection('ratgeber')).map((e) => ({ params: { slug: e.id }, props: { e } }));
}
const { e } = Astro.props;
const d = e.data;
const { Content } = await render(e);
const fmt = (x: Date) => x.toLocaleDateString('de-AT', { day: '2-digit', month: 'long', year: 'numeric' });
const crumbs = [{ name: 'Ratgeber', url: '/ratgeber/' }, { name: d.titel, url: `/ratgeber/${e.id}/` }];
const schema = [{ '@context': 'https://schema.org', '@type': 'Article', headline: d.titel, description: d.kurz, image: `https://schindelegger.at${d.bild}`, datePublished: d.datum.toISOString(), dateModified: (d.aktualisiert || d.datum).toISOString(), author: { '@type': 'Person', name: s.inhaberKurz, jobTitle: s.inhaberRolle, url: 'https://schindelegger.at/ueber-uns/' }, publisher: { '@id': 'https://schindelegger.at/#organization' }, mainEntityOfPage: `https://schindelegger.at/ratgeber/${e.id}/` }];
---
<Base title={d.seo.title || `${d.titel} | Schindelegger`} description={d.seo.description || d.kurz} image={d.bild} crumbs={crumbs} schema={schema} ogType="article">
  <section class="page-hero" data-hero>
    <div class="hero-bg"></div>
    <div class="wrap" style="max-width:900px">
      <nav class="crumbs" aria-label="Brotkrumen"><a href="/">Startseite</a><span>/</span><a href="/ratgeber/">Ratgeber</a></nav>
      <span class="eyebrow">{d.kategorie} · {d.lesezeit} Min. Lesezeit</span>
      <h1 style="font-size:clamp(2rem,1.3rem+2.8vw,3.4rem)">{d.titel}</h1>
      <p class="lead">{d.kurz}</p>
      <div class="quote" style="flex-direction:row"><div class="who"><img class="avatar" src={s.inhaberBild} alt="" width="44" height="44" /><span><b>{s.inhaberKurz}</b>{s.inhaberRolle}</span></div></div>
      <p class="updated" style="margin-top:12px">Veröffentlicht am {fmt(d.datum)}{d.aktualisiert && <> · Zuletzt aktualisiert am {fmt(d.aktualisiert)}</>}</p>
      <div class="rounded-img" style="margin-top:28px;aspect-ratio:16/8"><img src={d.bild} alt={d.bildAlt} width="1600" height="800" sizes="(max-width: 1280px) 100vw, 1240px" fetchpriority="high" /></div>
    </div>
  </section>
  <section class="section" style="padding-top:0"><div class="wrap" style="max-width:900px"><article class="prose"><Content /></article></div></section>
  {d.faq.length > 0 && <section class="section alt"><div class="wrap" style="max-width:900px"><div class="head"><span class="eyebrow">FAQ</span><h2>Häufige Fragen.</h2></div><Faq items={d.faq} /></div></section>}
  <CtaBand />
</Base>

---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CaseCard from '../../components/CaseCard.astro';
import Testimonials from '../../components/Testimonials.astro';
import Stats from '../../components/Stats.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection } from 'astro:content';
const cases = (await getCollection('referenzen')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
const crumbs = [{ name: 'Referenzen', url: '/referenzen/' }];
---
<Base title="Referenzen & Case Studies | Schindelegger Wien" description="Case Studies aus eCommerce, Pflege, Industrie und Fashion: +350 % Anfragen, ROAS 22, +24 % Umsatz. Ergebnisse statt Versprechen." crumbs={crumbs}>
  <PageHero eyebrow="Referenzen" h1="Ergebnisse statt Versprechen." intro="Eine Auswahl an Projekten quer durch Branchen. Jede Karte zeigt, was erreicht wurde, mit der Kennzahl, die wirklich zählt." antwort="Zu den Kunden von Schindelegger zählen Vitabene (+350 % Anfragen), Alpenaquafarm Tirol (ROAS 22), ARB Nutrition (+24 % Umsatz), NT Service (+35 % B2B-Anfragen), lounge8, United Nude, EVRVEST und die Göls Gruppe." bild="/images/heroes/referenzen-hero.webp" bildAlt="Shop- und Website-Projekte auf Laptop und Bildschirmen" crumbs={crumbs} />
  <section class="section alt"><div class="wrap"><div class="grid g2">{cases.map((c) => <CaseCard c={c} h="h2" />)}</div></div></section>
  <section class="section dark"><div class="wrap"><div class="head"><span class="eyebrow">In Summe</span><h2>Was dabei herauskommt.</h2></div><Stats /></div></section>
  <section class="section"><div class="wrap"><div class="head"><span class="eyebrow">Kundenstimmen</span><h2>Was Kunden sagen.</h2></div><Testimonials /></div></section>
  <CtaBand h2="Ihr Unternehmen als nächste Case Study?" />
</Base>

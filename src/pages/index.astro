---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Partners from '../components/Partners.astro';
import Stats from '../components/Stats.astro';
import CaseCard from '../components/CaseCard.astro';
import Testimonials from '../components/Testimonials.astro';
import ContactForm from '../components/ContactForm.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import { getCollection } from 'astro:content';
import h from '../data/home.json';
import g from '../data/growth.json';
import s from '../data/settings.json';

const leistungen = (await getCollection('leistungen')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
const lMap = Object.fromEntries(leistungen.map((l) => [l.id, l]));
const cases = (await getCollection('referenzen')).filter((c) => c.data.featured).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge).slice(0, 2);
const artikel = (await getCollection('ratgeber')).sort((a, b) => +b.data.datum - +a.data.datum).slice(0, 3);
const tel = s.telefon.replace(/\s/g, '');
---
<Base title={h.seo.title} description={h.seo.description}>
  <section class="hero" data-hero>
    <div class="hero-bg"></div>
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">{h.hero.eyebrow}</span>
        <h1>{h.hero.h1Vor} <span class="mark">{h.hero.h1Mark}</span> {h.hero.h1Nach}</h1>
        <p class="sub">{h.hero.sub}</p>
        <div class="btn-row" style="margin-top:28px">
          <a class="btn btn-primary" href="#beratung" data-modal data-track="hero_cta">{h.hero.cta} <Icon name="arrow" /></a>
          <a class="btn btn-outline" href="/referenzen/" data-track="hero_cases">{h.hero.cta2}</a>
        </div>
        <ul class="trust-bullets">
          {h.hero.bullets.map((b) => <li><span class="check"><Icon name="check" /></span>{b}</li>)}
        </ul>
      </div>
      <div class="hero-media">
        <div class="frame">
          <video autoplay muted loop playsinline preload="metadata" poster={h.hero.poster} aria-label="Einblick in die Arbeit von Schindelegger in Wien">
            <source src={h.hero.video} type="video/mp4" />
          </video>
        </div>
        <div class="float-card tr"><span class="icon-bubble"><Icon name="chart" /></span><span><strong>{h.hero.karteOben.titel}</strong>{h.hero.karteOben.text}</span></div>
        <div class="float-card bl"><img class="avatar" src={s.inhaberBild} alt="" width="44" height="44" /><span><strong>{h.hero.karteUnten.titel}</strong>{h.hero.karteUnten.text}</span></div>
      </div>
    </div>
  </section>

  <Partners />

  <section class="section">
    <div class="wrap">
      <div class="head reveal">
        <span class="eyebrow">{h.vergleich.eyebrow}</span>
        <h2>{h.vergleich.h2}</h2>
        <p class="lead">{h.vergleich.intro}</p>
      </div>
      <div class="table-wrap reveal">
        <table class="compare vs">
          <thead><tr><th scope="col"><span class="sr-only">Thema</span></th><th scope="col">Klassische Agentur</th><th scope="col" class="me">schindelegger<span style="color:var(--accent)">.</span></th></tr></thead>
          <tbody>
            {h.vergleich.zeilen.map((z) => <tr><th scope="row">{z.thema}</th><td class="muted">{z.agentur}</td><td class="me"><span class="check"><Icon name="check" /></span>{z.ich}</td></tr>)}
          </tbody>
        </table>
      </div>
      <div class="btn-row" style="margin-top:28px"><a class="btn btn-primary" href="#beratung" data-modal data-track="vergleich_cta">Kennenlernen vereinbaren <Icon name="arrow" /></a></div>
    </div>
  </section>

  <section class="section dark" id="ueber">
    <div class="wrap">
      <div class="split top">
        <div class="head reveal">
          <span class="eyebrow">{h.ueber.eyebrow}</span>
          <h2>{h.ueber.h2}</h2>
        </div>
        <p class="lead reveal">{h.ueber.text}</p>
      </div>
      <Stats />
      <p class="result-band reveal">Im Schnitt erreichen meine Kunden <span><b>+{s.ergebnis.umsatz} %</b>mehr Umsatz</span><span><b>−{s.ergebnis.kosten} %</b>weniger Werbeausgaben</span></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head reveal" style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:20px">
        <div><span class="eyebrow">Cases</span><h2>Ausgewählte Projekte. Messbare Ergebnisse.</h2></div>
        <a class="link-arrow" href="/referenzen/">Alle Cases <Icon name="arrow" /></a>
      </div>
      <div class="grid g2">
        {cases.map((c) => <CaseCard c={c} />)}
      </div>
    </div>
  </section>

  <section class="section alt" id="leistungen">
    <div class="wrap">
      <div class="head reveal">
        <span class="eyebrow">{h.leistungen.eyebrow}</span>
        <h2>{h.leistungen.h2}</h2>
        <p class="lead">{h.leistungen.intro}</p>
      </div>
      <div class="grid g2">
        {h.leistungen.bereiche.map((b) => (
          <div class="card bereich reveal">
            <span class="icon-bubble"><Icon name={b.icon} /></span>
            <h3>{b.titel}</h3>
            <p class="muted">{b.text}</p>
            <ul class="bereich-links">
              {b.links.filter((id) => lMap[id]).map((id) => <li><a href={`/leistungen/${id}/`}>{lMap[id].data.titel}<Icon name="arrow" /></a></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head reveal">
        <span class="eyebrow">{h.werte.eyebrow}</span>
        <h2>{h.werte.h2}</h2>
      </div>
      <div class="grid g3">
        {h.werte.items.map((w) => <div class="card reveal"><span class="icon-bubble" style="margin-bottom:16px"><Icon name={w.icon} /></span><h3>{w.titel}</h3><p class="muted">{w.text}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <div class="head reveal">
        <span class="eyebrow">{h.onboarding.eyebrow}</span>
        <h2>{h.onboarding.h2}</h2>
        <p class="lead">{h.onboarding.intro}</p>
      </div>
      <div class="steps" style="--n:3">
        {g.phasen.map((p, i) => (
          <div class="step reveal">
            <div class="img"><img src={p.bild} alt={p.titel} width="600" height="450" loading="lazy" /></div>
            <span class="num">0{i + 1} / 03</span>
            <h3 style="margin-top:8px">{p.titel}</h3>
            <p class="muted">{p.text}</p>
            <span class="time">{p.zeit}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap brief reveal">
      <img src={s.inhaberBild} alt="Julian Schindelegger" width="440" height="550" loading="lazy" />
      <div>
        <span class="eyebrow">{h.brief.eyebrow}</span>
        <h2>{h.brief.h2}</h2>
        {h.brief.absaetze.map((a) => <p class="lead" style="font-size:1.08rem">{a}</p>)}
        <p class="sig">{h.brief.gruss}</p>
        <a class="btn btn-primary" href="#beratung" data-modal data-track="brief_cta">Kennenlernen vereinbaren <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <div class="head reveal" style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:20px">
        <div><span class="eyebrow">Kundenstimmen</span><h2>Kunden, die bleiben.</h2></div>
        <div style="font:800 2.6rem/1 var(--font-head)">{s.verlaengerung}<span class="muted" style="display:block;font:600 .9rem var(--font-body)">verlängerte Mandate</span></div>
      </div>
      <Testimonials />
    </div>
  </section>

  <section class="section" id="faq">
    <div class="wrap split top">
      <div class="head reveal"><span class="eyebrow">{h.faq.eyebrow}</span><h2>{h.faq.h2}</h2><p class="lead">Ihre Frage ist nicht dabei? Fragen Sie mich einfach direkt.</p></div>
      <div class="reveal"><Faq items={h.faq.items} /></div>
    </div>
  </section>

  {artikel.length > 0 && (
    <section class="section alt">
      <div class="wrap">
        <div class="head reveal" style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:20px">
          <div><span class="eyebrow">Ratgeber</span><h2>Wissen, das weiterbringt.</h2></div>
          <a class="link-arrow" href="/ratgeber/">Alle Artikel <Icon name="arrow" /></a>
        </div>
        <div class="grid g3">
          {artikel.map((a) => (
            <a class="card case-card reveal" href={`/ratgeber/${a.id}/`}>
              <div class="img"><img src={a.data.bild} alt={a.data.bildAlt} width="800" height="500" loading="lazy" /></div>
              <div class="body"><span class="cat">{a.data.kategorie} · {a.data.lesezeit} Min.</span><h3 style="margin-top:8px">{a.data.titel}</h3><p class="muted" style="font-size:.95rem">{a.data.kurz}</p><span class="link-arrow">Lesen <Icon name="arrow" /></span></div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section" id="kontakt">
    <div class="wrap split top">
      <div class="reveal">
        <span class="eyebrow">Kontakt</span>
        <h2>{h.kontakt.h2}</h2>
        <p class="lead">{h.kontakt.text}</p>
        <ul class="checks" style="margin:24px 0">
          {h.kontakt.punkte.map((p) => <li><span class="check"><Icon name="check" /></span>{p}</li>)}
        </ul>
        <p><a href={`mailto:${s.email}`}>{s.email}</a><br /><a href={`tel:${tel}`} data-track="kontakt">{s.telefon}</a><br />{s.plz} {s.ort}</p>
      </div>
      <div class="reveal"><ContactForm /></div>
    </div>
  </section>

  <CtaBand h2="Bereit für Wachstum?" text="Ein kurzes Gespräch zeigt, wo Ihr größter ungenutzter Hebel liegt. Kostenlos, unverbindlich und ehrlich." />
</Base>
